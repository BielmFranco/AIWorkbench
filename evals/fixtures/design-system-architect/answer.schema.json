{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "semantic_role",
    "themes",
    "compatibility_mapping",
    "contrast_verified",
    "rationale"
  ],
  "properties": {
    "semantic_role": {
      "type": "string",
      "minLength": 1
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "compatibility_mapping": {
      "type": "boolean"
    },
    "contrast_verified": {
      "type": "boolean"
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  }
}
