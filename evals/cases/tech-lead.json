      "fixtures": "evals/fixtures/tech-lead",
      "assertions": [
        {
          "id": "answer-contract",
          "kind": "json_schema",
          "artifact": "answer.json",
          "schema": "evals/fixtures/tech-lead/answer.schema.json"
        },
        {
          "id": "outcome-1",
          "kind": "json_value",
