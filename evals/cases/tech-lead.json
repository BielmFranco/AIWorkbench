        {
          "id": "outcome-3",
          "kind": "json_value",
          "artifact": "answer.json",
          "pointer": "/recovery_path",
          "expected": "monolith_read"
        },
        {
          "id": "outcome-4",
          "kind": "json_value",
          "artifact": "answer.json",
          "pointer": "/executed",
          "expected": false
