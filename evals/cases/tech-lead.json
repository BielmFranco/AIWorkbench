  "cases": [
    {
      "id": "tech-lead-routing-1",
      "mode": "routing",
      "skill_under_test": "tech-lead",
      "prompt": "Use $tech-lead para planejar a migração de leituras com duas equipes e rollback.",
      "expected_skill": "tech-lead",
      "language": "pt"
    },
    {
      "id": "tech-lead-routing-2",
      "mode": "routing",
      "skill_under_test": "tech-lead",
      "prompt": "We need milestones and owners for a zero-downtime account-read migration; writes stay in the monolith.",
      "expected_skill": "tech-lead",
      "language": "en"
    },
    {
      "id": "tech-lead-routing-3",
      "mode": "routing",
      "skill_under_test": "tech-lead",
      "prompt": "Renomeie somente este helper privado.",
      "expected_skill": null,
      "language": "pt"
    },
    {
      "id": "tech-lead-normal",
      "mode": "outcome",
      "prompt": "Read fixtures/brief.json and fulfill its task using only local artifacts. Save files in output/.",
      "fixtures": "evals/fixtures/tech-lead",
      "assertions": [
        {
          "id": "answer-contract",
          "kind": "json_schema",
          "artifact": "answer.json",
          "schema": "evals/fixtures/tech-lead/answer.schema.json"
        },
        {
          "id": "outcome-1",
          "kind": "json_value",
          "artifact": "answer.json",
          "pointer": "/write_owner",
          "expected": "monolith"
        },
        {
          "id": "outcome-2",
          "kind": "json_value",
          "artifact": "answer.json",
          "pointer": "/stop_on",
          "expected": "unexplained_mismatch"
        },
        {
          "id": "outcome-3",
          "kind": "json_value",
          "artifact": "answer.json",
          "pointer": "/recovery_path",
          "expected": "monolith_read"
        },
        {
          "id": "outcome-4",
          "kind": "json_value",
          "artifact": "answer.json",
          "pointer": "/executed",
          "expected": false
        }
      ],
      "human_rubric": [
        {
          "id": "milestone-evidence",
          "criterion": "Milestones are independently verifiable.",
          "pass_anchor": "Each proposed milestone has an owner or unassigned role, dependency and exit check; uses the supplied latency budget and does not claim rollout evidence."
        }
      ]
    },
    {
