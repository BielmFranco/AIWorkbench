{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIWorkbench evaluation case v2",
  "oneOf": [{"$ref": "#/$defs/routing"}, {"$ref": "#/$defs/outcome"}],
  "$defs": {
    "routing": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "mode", "skill_under_test", "prompt", "expected_skill", "language"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
        "mode": {"const": "routing"},
        "skill_under_test": {"type": "string", "minLength": 1},
        "prompt": {"type": "string", "minLength": 1},
        "expected_skill": {"type": ["string", "null"]},
        "language": {"enum": ["pt", "en"]}
      }
    },
    "assertion": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "artifact"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
        "kind": {"enum": ["json_schema", "json_value", "json_one_of", "python_test"]},
        "artifact": {"type": "string", "minLength": 1},
        "schema": {"type": "string", "minLength": 1},
        "test": {"type": "string", "minLength": 1},
        "pointer": {"type": "string", "pattern": "^(/.*)?$"},
        "expected": {},
        "values": {"type": "array", "minItems": 1}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "json_schema"}}}, "then": {"required": ["schema"]}},
        {"if": {"properties": {"kind": {"const": "json_value"}}}, "then": {"required": ["pointer", "expected"]}},
        {"if": {"properties": {"kind": {"const": "json_one_of"}}}, "then": {"required": ["pointer", "values"]}},
        {"if": {"properties": {"kind": {"const": "python_test"}}}, "then": {"required": ["test"]}}
      ]
    },
    "outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "mode", "prompt", "fixtures", "assertions", "human_rubric"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"},
        "mode": {"const": "outcome"},
        "prompt": {"type": "string", "minLength": 1},
        "fixtures": {"type": "string", "minLength": 1},
        "assertions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assertion"}},
        "human_rubric": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "criterion", "pass_anchor"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "criterion": {"type": "string", "minLength": 1},
              "pass_anchor": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
